{
  "name": "asobiroom-gunman",
  "main": "gunman-worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://asobiroom.net,http://localhost:4173,http://127.0.0.1:4173"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "DuelRoom"
      },
      {
        "name": "LOBBY",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DuelRoom",
        "Matchmaker"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "asobiroom-gunman",
      "database_id": "450042d9-6a83-45bf-a657-5dfe45c4bba9"
    },
    {
      "binding": "PROFILE_DB",
      "database_name": "asobiroom-stats",
      "database_id": "dfc951b1-2088-4e31-9dca-14c44de898f6"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true
    }
  }
}
